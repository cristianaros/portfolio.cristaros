---
import ActivityBarWidgets from "../components/ActivityBarWidgets";
import { ClientRouter } from "astro:transitions";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  activeFile?: string;
}

const { title = "Cristian Aros | FullStack Developer", activeFile = "README.md" } =
  Astro.props;
const isExperience = activeFile === "experiencia.md" || activeFile === "experience.md";
const experienceHref = activeFile === "experience.md" ? "/experience" : "/experiencia";
const experienceLabel = activeFile === "experience.md" ? "experience.md" : "experiencia.md";
const activeFileEn = activeFile === "proyectos.json" ? "projects.json" : activeFile;
---

<!doctype html>
<html lang={activeFile === "experience.md" ? "en" : "es"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1e1e2e" />
    <meta property="og:title" content="Portfolio | Cristian Aros" />
    <meta
      property="og:description"
      content="Portfolio profesional simulando Visual Studio Code — Ingeniero Civil Informático y Desarrollador Full Stack."
      data-en-content="Professional VS Code-inspired portfolio by Cristian Aros, a full-stack developer."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://portfolio.cristaros.com/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="description"
      content="Portfolio profesional de Cristian Aros — Ingeniero Civil Informático y Desarrollador de Software"
      data-en-content="Cristian Aros's portfolio — computer engineering and software development"
    />
    <meta name="author" content="Cristian Aros" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // Prevent flash of wrong theme
      (function () {
        const getLocale = () => {
          if (/^\/experience\/?$/.test(location.pathname)) return "en";
          if (/^\/experiencia\/?$/.test(location.pathname)) return "es";
          try {
            const selected = localStorage.getItem("portfolio-locale");
            if (selected === "es" || selected === "en") return selected;
          } catch {}
          const preferred = navigator.languages?.[0] || navigator.language || "es";
          return preferred.toLowerCase().startsWith("en") ? "en" : "es";
        };
        const setLocale = () => {
          const locale = getLocale();
          if (/^\/(experience|experiencia)\/?$/.test(location.pathname)) {
            try { localStorage.setItem("portfolio-locale", locale); } catch {}
          }
          document.documentElement.lang = locale;
          document.documentElement.dataset.locale = locale;
          document.querySelectorAll("[data-set-locale]").forEach((button) => {
            button.setAttribute("aria-pressed", String(button.getAttribute("data-set-locale") === locale));
          });
          const controlLabels = {
            "Explorador": "Explorer",
            "Buscar (no disponible)": "Search (unavailable)",
            "Cuenta (no disponible)": "Account (unavailable)",
            "Más acciones del explorador (no disponible)": "More explorer actions (unavailable)",
            "Panel (no disponible)": "Panel (unavailable)",
            "Barra lateral secundaria (no disponible)": "Secondary sidebar (unavailable)",
          };
          if (locale === "en") {
            document.querySelectorAll("[aria-label], [title]").forEach((element) => {
              for (const attribute of ["aria-label", "title"]) {
                const original = element.getAttribute(attribute);
                if (original && controlLabels[original]) element.setAttribute(attribute, controlLabels[original]);
              }
            });
          }
          document.querySelectorAll("[data-en]").forEach((element) => {
            if (locale === "en") element.textContent = element.getAttribute("data-en");
          });
          document.querySelectorAll("[data-en-href]").forEach((element) => {
            if (locale === "en") element.setAttribute("href", element.getAttribute("data-en-href"));
          });
          document.querySelectorAll("[data-en-aria]").forEach((element) => {
            if (locale === "en") element.setAttribute("aria-label", element.getAttribute("data-en-aria"));
          });
          document.querySelectorAll("[data-en-title]").forEach((element) => {
            if (locale === "en") element.setAttribute("title", element.getAttribute("data-en-title"));
          });
          document.querySelectorAll("[data-en-content]").forEach((element) => {
            if (locale === "en") element.setAttribute("content", element.getAttribute("data-en-content"));
          });
        };
        setLocale();
        document.addEventListener("DOMContentLoaded", setLocale, { once: true });
        const syncThemeColor = () => {
          const theme = document.documentElement.getAttribute("data-theme");
          document.querySelector('meta[name="theme-color"]')?.setAttribute(
            "content",
            theme === "light" ? "#fafafa" : "#1e1e2e",
          );
        };
        try {
          const stored = localStorage.getItem("portfolio-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.setAttribute("data-theme", stored);
          }
        } catch {}
        syncThemeColor();
        document.addEventListener("astro:after-swap", syncThemeColor);
        document.addEventListener("astro:after-swap", setLocale);
        document.addEventListener("astro:page-load", setLocale);
      })();
    </script>
  </head>
  <body
    class="h-screen w-screen overflow-hidden bg-vscode-bg text-vscode-text font-mono flex flex-col"
    style="height:100vh;height:100dvh;min-height:100dvh">
    <!-- ===== MOBILE HEADER (visible only on small screens) ===== -->
    <header
      class="flex md:hidden items-center justify-between h-10 bg-vscode-menu border-b border-vscode-border px-3 shrink-0"
      style="padding-top:env(safe-area-inset-top);height:calc(2.5rem + env(safe-area-inset-top))">
      <button
        id="mobile-menu-btn"
        class="w-10 h-10 flex items-center justify-center text-vscode-textMuted hover:text-vscode-text transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vscode-accent"
        title="Menú" data-en-title="Menu"
        aria-label="Menú"
        data-en-aria="Menu"
        aria-expanded="false"
        aria-controls="mobile-drawer">
        <svg aria-hidden="true"
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      <span class="text-[12px] text-vscode-textMuted truncate mx-2" data-en={activeFileEn}
        >{activeFile}</span
      >
      <div class="w-8"></div>
    </header>

    <!-- ===== MOBILE DRAWER ===== -->
    <div
      id="mobile-drawer-overlay"
      class="fixed inset-0 z-[60] bg-black/40 hidden md:hidden"
      style="opacity:0;transition:opacity 0.2s ease">
      <button
        type="button"
        class="absolute inset-0 h-full w-full cursor-default"
        aria-label="Cerrar explorador"
        data-en-aria="Close explorer"
        aria-hidden="true"
        tabindex="-1"></button>
      <aside
        id="mobile-drawer"
        class="absolute left-0 top-0 bottom-0 w-64 bg-vscode-sidebar border-r border-vscode-border flex flex-col overflow-y-auto"
        role="dialog"
        aria-modal="true"
        aria-labelledby="mobile-drawer-title"
        style="transform:translateX(-100%);transition:transform 0.25s ease;overscroll-behavior:contain;padding-top:env(safe-area-inset-top);padding-bottom:env(safe-area-inset-bottom)">
        <!-- Drawer Header -->
        <div
          class="flex items-center justify-between px-4 py-3 border-b border-vscode-border">
          <span id="mobile-drawer-title"
            class="text-[11px] tracking-wider uppercase text-vscode-textMuted font-semibold"
            data-en="Explorer">Explorador</span
          >
          <button
            id="mobile-drawer-close"
            class="w-8 h-8 flex items-center justify-center rounded hover:bg-vscode-surface0/50 text-vscode-textMuted hover:text-vscode-text transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vscode-accent"
            aria-label="Cerrar explorador" data-en-aria="Close explorer">
            <svg aria-hidden="true"
              class="w-4 h-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"></path></svg
            >
          </button>
        </div>

        <!-- File Tree -->
        <div class="px-3 py-2 flex flex-col text-[13px] gap-0.5">
          <div
            class="flex items-center gap-1 px-2 py-1 text-[11px] tracking-wider uppercase text-vscode-textMuted font-semibold mb-1">
            <svg aria-hidden="true"
              class="w-3 h-3 transform rotate-90"
              fill="currentColor"
              viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg
            >
            <span>Portfolio</span>
          </div>

          <!-- README.md -->
          <a
            href="/"
            class={`flex items-center gap-2 px-3 py-2 rounded-md transition-colors ${activeFile === "README.md" ? "bg-vscode-surface0/70 text-vscode-text" : "text-vscode-textSubtle hover:bg-vscode-surface0/50"}`}>
            <svg aria-hidden="true"
              class="w-4 h-4 text-vscode-accent shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M14.85 3H5.15A2.16 2.16 0 003 5.15v13.7A2.16 2.16 0 005.15 21h13.7A2.16 2.16 0 0021 18.85V9.15L14.85 3zm-.35 2.12L17.88 8.5h-3.38V5.12zM5 18.85V5.15A.15.15 0 015.15 5H13v5h5v8.85a.15.15 0 01-.15.15H5.15A.15.15 0 015 18.85z"
              ></path></svg
            >
            <span>README.md</span>
          </a>

          <!-- proyectos.json -->
          <a
            href="/proyectos"
            class={`flex items-center gap-2 px-3 py-2 rounded-md transition-colors ${activeFile === "proyectos.json" ? "bg-vscode-surface0/70 text-vscode-text" : "text-vscode-textSubtle hover:bg-vscode-surface0/50"}`}>
            <svg aria-hidden="true"
              class="w-4 h-4 text-vscode-yellow shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M5 3h2v2H5v5a2 2 0 01-2 2 2 2 0 012 2v5h2v2H5c-1.07-.27-2-.9-2-2v-4a2 2 0 00-2-2H0v-2h1a2 2 0 002-2V5a2 2 0 012-2m14 0a2 2 0 012 2v4a2 2 0 002 2h1v2h-1a2 2 0 00-2 2v4a2 2 0 01-2 2h-2v-2h2v-5a2 2 0 012-2 2 2 0 01-2-2V5h-2V3h2M12 15a1 1 0 110 2 1 1 0 010-2m-4 0a1 1 0 110 2 1 1 0 010-2m8 0a1 1 0 110 2 1 1 0 010-2z"
              ></path></svg
            >
            <span data-en="projects.json">proyectos.json</span>
          </a>

          <!-- experiencia.md / experience.md -->
          <a
            href={experienceHref}
            data-en-href="/experience"
            aria-current={isExperience ? "page" : undefined}
            class={`flex items-center gap-2 px-3 py-2 rounded-md transition-colors ${isExperience ? "bg-vscode-surface0/70 text-vscode-text" : "text-vscode-textSubtle hover:bg-vscode-surface0/50"}`}>
            <svg aria-hidden="true" class="w-4 h-4 text-vscode-green shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 3h16v18H4zM8 8h8M8 12h8M8 16h5" /></svg>
            <span data-en="experience.md">{experienceLabel}</span>
          </a>

          <!-- config.json -->
          <button
            id="mobile-config-json-btn"
            class="flex items-center gap-2 px-3 py-2 rounded-md hover:bg-vscode-surface0/50 transition-colors w-full text-left text-vscode-textSubtle">
            <svg aria-hidden="true"
              class="w-4 h-4 text-vscode-yellow shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M5 3h2v2H5v5a2 2 0 01-2 2 2 2 0 012 2v5h2v2H5c-1.07-.27-2-.9-2-2v-4a2 2 0 00-2-2H0v-2h1a2 2 0 002-2V5a2 2 0 012-2m14 0a2 2 0 012 2v4a2 2 0 002 2h1v2h-1a2 2 0 00-2 2v4a2 2 0 01-2 2h-2v-2h2v-5a2 2 0 012-2 2 2 0 01-2-2V5h-2V3h2M12 15a1 1 0 110 2 1 1 0 010-2m-4 0a1 1 0 110 2 1 1 0 010-2m8 0a1 1 0 110 2 1 1 0 010-2z"
              ></path></svg
            >
            <span>config.json</span>
          </button>
        </div>
        <div class="mt-auto border-t border-vscode-border px-4 py-3 flex items-center justify-between">
          <span class="text-[11px] uppercase tracking-wider text-vscode-textMuted" data-en="Language">Idioma</span>
          <div role="group" aria-label="Cambiar idioma" data-en-aria="Change language" class="flex gap-1">
            <button type="button" data-set-locale="es" aria-label="Español" aria-pressed="false" class="h-10 w-10 rounded text-xs font-semibold text-vscode-textMuted hover:text-vscode-text aria-pressed:bg-vscode-accent/20 aria-pressed:text-vscode-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vscode-accent">ES</button>
            <button type="button" data-set-locale="en" aria-label="English" aria-pressed="false" class="h-10 w-10 rounded text-xs font-semibold text-vscode-textMuted hover:text-vscode-text aria-pressed:bg-vscode-accent/20 aria-pressed:text-vscode-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vscode-accent">EN</button>
          </div>
        </div>
      </aside>
    </div>

    <nav aria-label="Navegación rápida" data-en-aria="Quick navigation">
      <a
        href="#main-content"
        class="sr-only fixed left-3 top-3 z-[100] rounded bg-vscode-accent px-4 py-2 text-sm font-semibold text-vscode-bg focus:not-sr-only focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-vscode-text">
        <span data-en="Skip to main content">Saltar al contenido principal</span>
      </a>
    </nav>

    <!-- ===== MAIN CONTENT ===== -->
    <div class="flex flex-1 overflow-hidden">
      <!-- ===== ACTIVITY BAR (hidden on mobile) ===== -->
      <aside
        aria-label="Barra de actividades"
        data-en-aria="Activity bar"
        class="hidden md:flex w-12 bg-vscode-menu border-r border-vscode-border flex-col items-center py-2 gap-1 shrink-0">
        <!-- Explorer (active) -->
        <button
          class="w-10 h-10 flex items-center justify-center text-vscode-text border-l-2 border-vscode-accent rounded-none hover:bg-vscode-surface0/30 transition-colors"
          title="Explorador"
          aria-label="Explorador"
          disabled>
          <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M17.5 0h-9L7 1.5V6H2.5L1 7.5v15.07L2.5 24h12.07L16 22.57V18h4.7l1.3-1.43V4.5L17.5 0zm0 2.12l2.38 2.38H17.5V2.12zm-3 20.38h-12v-15H7v9.07L8.5 18h6v4.5zm6-6h-12v-15H16V6h4.5v10.5z"
            ></path></svg
          >
        </button>

        <!-- Search -->
        <button
          class="w-10 h-10 flex items-center justify-center text-vscode-textMuted opacity-40 cursor-not-allowed"
          title="Buscar (no disponible)"
          aria-label="Buscar (no disponible)"
          disabled>
          <svg aria-hidden="true"
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
          >
        </button>

        <div class="flex-1"></div>

        <!-- User -->
        <button
          class="w-10 h-10 flex items-center justify-center text-vscode-textMuted opacity-40 cursor-not-allowed"
          title="Cuenta (no disponible)"
          aria-label="Cuenta (no disponible)"
          disabled>
          <svg aria-hidden="true"
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
            ></path></svg
          >
        </button>

        <!-- Settings (React Island) -->
        <ActivityBarWidgets client:load />
      </aside>

      <!-- ===== SIDEBAR EXPLORER (hidden on mobile) ===== -->
      <aside
        aria-label="Explorador de archivos"
        data-en-aria="File explorer"
        class="hidden md:flex w-56 bg-vscode-sidebar border-r border-vscode-border flex-col shrink-0 select-none">
        <!-- Explorer Header -->
        <div
          class="flex items-center justify-between px-4 py-2 text-[11px] tracking-wider uppercase text-vscode-textMuted">
          <span data-en="Explorer">Explorador</span>
          <button
            class="text-vscode-textMuted text-lg leading-none opacity-50 cursor-not-allowed"
            aria-label="Más acciones del explorador (no disponible)"
            title="Más acciones del explorador (no disponible)"
            disabled>···</button
          >
        </div>

        <!-- Portfolio Folder -->
        <div class="px-2">
          <div
            class="flex items-center gap-1 px-2 py-0.5 text-[11px] tracking-wider uppercase text-vscode-textMuted font-semibold">
            <svg aria-hidden="true"
              class="w-3 h-3 transform rotate-90"
              fill="currentColor"
              viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg
            >
            <span>Portfolio</span>
          </div>

          <!-- File Tree -->
          <div class="ml-2 flex flex-col text-[13px]">
            <!-- README.md -->
            <a
              href="/"
              class={`flex items-center gap-2 px-2 py-0.5 rounded hover:bg-vscode-surface0/50 transition-colors w-full text-left ${activeFile === "README.md" ? "bg-vscode-surface0/70 text-vscode-text" : "text-vscode-textSubtle"}`}>
              <svg aria-hidden="true"
                class="w-4 h-4 text-vscode-accent shrink-0"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M14.85 3H5.15A2.16 2.16 0 003 5.15v13.7A2.16 2.16 0 005.15 21h13.7A2.16 2.16 0 0021 18.85V9.15L14.85 3zm-.35 2.12L17.88 8.5h-3.38V5.12zM5 18.85V5.15A.15.15 0 015.15 5H13v5h5v8.85a.15.15 0 01-.15.15H5.15A.15.15 0 015 18.85z"
                ></path></svg
              >
              <span>README.md</span>
            </a>

            <!-- proyectos.json -->
            <a
              href="/proyectos"
              class={`flex items-center gap-2 px-2 py-0.5 rounded hover:bg-vscode-surface0/50 transition-colors w-full text-left ${activeFile === "proyectos.json" ? "bg-vscode-surface0/70 text-vscode-text" : "text-vscode-textSubtle"}`}>
              <svg aria-hidden="true"
                class="w-4 h-4 text-vscode-yellow shrink-0"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M5 3h2v2H5v5a2 2 0 01-2 2 2 2 0 012 2v5h2v2H5c-1.07-.27-2-.9-2-2v-4a2 2 0 00-2-2H0v-2h1a2 2 0 002-2V5a2 2 0 012-2m14 0a2 2 0 012 2v4a2 2 0 002 2h1v2h-1a2 2 0 00-2 2v4a2 2 0 01-2 2h-2v-2h2v-5a2 2 0 012-2 2 2 0 01-2-2V5h-2V3h2M12 15a1 1 0 110 2 1 1 0 010-2m-4 0a1 1 0 110 2 1 1 0 010-2m8 0a1 1 0 110 2 1 1 0 010-2z"
                ></path></svg
              >
              <span data-en="projects.json">proyectos.json</span>
            </a>

            <!-- experiencia.md / experience.md -->
            <a
              href={experienceHref}
              data-en-href="/experience"
              aria-current={isExperience ? "page" : undefined}
              class={`flex items-center gap-2 px-2 py-0.5 rounded hover:bg-vscode-surface0/50 transition-colors w-full text-left ${isExperience ? "bg-vscode-surface0/70 text-vscode-text" : "text-vscode-textSubtle"}`}>
              <svg aria-hidden="true" class="w-4 h-4 text-vscode-green shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 3h16v18H4zM8 8h8M8 12h8M8 16h5" /></svg>
              <span data-en="experience.md">{experienceLabel}</span>
            </a>

            <!-- habilidades.ts -->
            <div
              class="flex items-center gap-2 px-2 py-0.5 w-full text-left text-vscode-textSubtle">
              <svg aria-hidden="true"
                class="w-4 h-4 text-vscode-accent shrink-0"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M3 3h18v18H3V3m1.5 1.5v15h15v-15h-15M6 8.73c0-1.36 1.05-2.4 2.98-2.4 1.04 0 1.78.37 2.31.92l-.97.96c-.37-.37-.78-.56-1.31-.56-.81 0-1.31.53-1.31 1.32v4.06c0 .79.5 1.32 1.31 1.32.53 0 .97-.21 1.31-.56l.97.96c-.53.55-1.27.92-2.31.92C7.05 15.67 6 14.63 6 13.27V8.73m6 0c0-1.36 1.05-2.4 2.98-2.4 1.04 0 1.78.37 2.31.92l-.97.96c-.37-.37-.78-.56-1.31-.56-.81 0-1.31.53-1.31 1.32v4.06c0 .79.5 1.32 1.31 1.32.53 0 .97-.21 1.31-.56l.97.96c-.53.55-1.27.92-2.31.92-1.93 0-2.98-1.04-2.98-2.4V8.73z"
                ></path></svg
              >
              <span data-en="skills.ts">habilidades.ts</span>
            </div>

            <!-- estilos.css -->
            <div
              class="flex items-center gap-2 px-2 py-0.5 w-full text-left text-vscode-textSubtle">
              <svg aria-hidden="true"
                class="w-4 h-4 text-vscode-pink shrink-0"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M9.6 2.4L8.4 4H5.2A1.2 1.2 0 004 5.2v13.6A1.2 1.2 0 005.2 20h13.6a1.2 1.2 0 001.2-1.2V5.2A1.2 1.2 0 0018.8 4h-3.2L14.4 2.4H9.6z"
                ></path></svg
              >
              <span data-en="styles.css">estilos.css</span>
            </div>

            <!-- Folders -->
            <div
              class="flex items-center gap-2 px-2 py-0.5 text-vscode-textSubtle">
              <svg aria-hidden="true"
                class="w-4 h-4 text-vscode-peach shrink-0"
                fill="currentColor"
                viewBox="0 0 24 24"
